
// Brute Force Approach
// Time: O(n^2)
// Space: O(1)

//



// Optimized Approach
// Time: O(n)
// Space: O(1)

class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        int n =nums.size();

        vector<int>ans(n);

        for(int i=0 ; i< n; i++){
            ans[(i +k)%n]= nums[i];
          
        }
         nums=ans;
    }
};

