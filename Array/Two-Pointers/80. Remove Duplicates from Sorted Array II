
class Solution {
public:
    int removeDuplicates(vector<int>& nums) {

        int n = nums.size();

        // If array has 2 or fewer elements,
        // all elements are allowed.
        if(n <= 2)
            return n;

        // 'i' represents the position where
        // the next valid element will be placed.
        // First two elements are always allowed.
        int i = 2;

        // Start checking elements from index 2.
        for(int j = 2; j < n; j++)
        {
            // Check whether the current element
            // is different from the element
            // placed two positions before.
            if(nums[j] != nums[i - 2])
            {
                // Place the current element
                // at the next valid position.
                nums[i] = nums[j];

                // Move to the next position.
                i++;
            }
        }

        // Return the number of valid elements.
        return i;
    }
};
